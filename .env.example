# Application secret key
SECRET_KEY=your-secret-key-here

# Bind locally by default; use a reverse proxy for public HTTPS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8199

# Admin credentials (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# Yandex Smart Home token (optional, for weather monitoring)
YANDEX_TOKEN=

# Weather polling interval in seconds
POLL_INTERVAL_SECONDS=60

# Activity screenshots (default ./data/activity)
# ACTIVITY_DIR=./data/activity

# Optional currency provider. Missing rates return an explicit error.
OPENEXCHANGERATES_APP_ID=

# Host activity worker paths (defaults are relative to the project)
# ACTIVITY_DB=./data/main-project.db
# ACTIVITY_BREAKDOWN_DIR=./data/activity-days
